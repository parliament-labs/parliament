# Parliament — test-database credentials TEMPLATE.
#
# DO NOT FILL IN REAL PASSWORDS HERE. This file is tracked in git for
# documentation only. The actual credentials live OUTSIDE the repo.
#
# Setup (one-time):
#   1. mkdir -p ~/.parliament
#   2. cp tests/fixtures/secrets.env.template ~/.parliament/secrets.env
#   3. chmod 600 ~/.parliament/secrets.env
#   4. Edit ~/.parliament/secrets.env and replace the placeholders with
#      your actual local-dev passwords.
#   5. Add this line to ~/.zshrc (or ~/.bashrc):
#        [ -f ~/.parliament/secrets.env ] && source ~/.parliament/secrets.env
#   6. Open a new terminal (or `source ~/.parliament/secrets.env` to apply now).
#
# After setup, `mysql -u root sakila` and `psql -U postgres pagila` connect
# without typing a password literal. The integration-test harness
# (tests/.../run.sh) reads PARLIAMENT_*_PASS automatically.

# Standard env vars — picked up automatically by `mysql` / `psql` CLIs.
export MYSQL_PWD="REPLACE_WITH_LOCAL_MYSQL_PASSWORD"
export PGPASSWORD="REPLACE_WITH_LOCAL_POSTGRES_PASSWORD"

# Project-specific env vars — read by tests/.../run.sh.
export PARLIAMENT_MY_PASS="$MYSQL_PWD"
export PARLIAMENT_PG_PASS="$PGPASSWORD"
